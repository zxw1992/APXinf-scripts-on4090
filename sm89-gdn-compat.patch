+#[cfg(feature = "cuda")]
+#[no_mangle]
+pub extern "C" fn apxinf_flashinfer_gdn_launch(
+    _map_q: *const std::ffi::c_void,
+    _map_k: *const std::ffi::c_void,
+    _map_v: *const std::ffi::c_void,
+    _map_out: *const std::ffi::c_void,
+    _gate_log: *mut f32,
+    _beta: *mut f32,
+    _cu_seqlens: *mut i32,
+    _state: *mut f32,
+    _state_indices: *mut i32,
+    _checkpoint_state: *mut f32,
+    _cu_checkpoints: *mut i32,
+    _tensor_map_workspace: *mut u8,
+    _state_stride: i64,
+    _scale: f32,
+    _num_seqs: i32,
+    _q_heads: i32,
+    _v_heads: i32,
+    _total_tiles: i32,
+    _grid_x: i32,
+    _stream: *mut std::ffi::c_void,
+) -> i32 {
